# Скопируйте этот файл в .env и заполните значения.
# .env в репозиторий не коммитится (см. .gitignore) — секреты только там.

# ── Локальный сайт ───────────────────────────────────────────────────────
# Адрес, на котором поднимется страница. 127.0.0.1 — доступ только с этого
# компьютера (пароля на сайте нет). 0.0.0.0 — зайдут все в локальной сети:
# имеет смысл, только когда в цеху несколько рабочих мест.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# ── База и логи ──────────────────────────────────────────────────────────
# Журнал загрузок и сборок (кто прислал, что и чем кончилось). Данные самих
# смен живут файлами в data/shifts, в базе их нет.
DATABASE_URL=sqlite:///./web_database.db
LOG_LEVEL=INFO
LOG_FILE=logs/web.log

# ── ИИ для разбора переписки и фото ──────────────────────────────────────
# Разбирает грязную переписку и картинки, возвращая только СТРУКТУРУ; часы и
# суммы считает код. Если выключить — отчёт соберётся упрощённым, без Excel.
AI_ENABLED=
AI_API_KEY=
# Шлюз ИИ: например https://ru.cheapvibecode.ru/v1
AI_BASE_URL=
# Модель, например claude-sonnet-5
AI_MODEL=
# anthropic (Messages API) или openai (chat/completions) — зависит от шлюза.
AI_API_FORMAT=
# 8192: за смену по 5-6 станкам структура в 4096 не влезает.
AI_MAX_TOKENS=
# Таймаут ответа ИИ (сек). Разбор целого дня — тяжёлый запрос; «думающие»
# модели могут молчать в поток дольше 300 с.
AI_TIMEOUT=600
# Разбор ПО ОДНОМУ СТАНКУ ЗА ВЫЗОВ ИИ. Дороже и дольше (N запросов вместо
# одного), зато модель не теряет станки, операторов и часы. false — режим
# «весь день одним запросом».
AI_PER_MACHINE=true
# Сколько раз повторить запрос, если поток ИИ оборвался ПОСРЕДИ ответа
# (обрыв связи через шлюз, а не нехватка токенов).
AI_RETRIES=2

# ── Бесплатный OCR фотографий ────────────────────────────────────────────
# Фото сначала проходят распознавание локально (Tesseract, бесплатно, без
# сети): без текста — не сохраняем, с рабочим текстом — в ИИ уходит текст, а не
# картинка, посторонний текст показывается отдельным списком.
OCR_ENABLED=true
# Языки. Без пакета rus будет откат на eng (цифры счётчика читаются и так).
OCR_LANGS=rus+eng
# Windows: путь к программе, если её нет в PATH. Установщик —
# «Tesseract at UB Mannheim», при установке отметьте Russian.
# TESSERACT_CMD=
# Порог уверенности слова (ниже — шум на фактуре материала).
OCR_MIN_CONF=60
# Сколько цифр или символов считать признаком «на фото что-то написано».
OCR_MIN_DIGITS=3
OCR_MIN_CHARS=12
# true — снова отправлять в ИИ сами картинки: дороже, но рукописный журнал
# модель читает лучше Tesseract.
OCR_SEND_PHOTOS_TO_AI=false


