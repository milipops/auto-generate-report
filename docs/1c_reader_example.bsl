// ═══════════════════════════════════════════════════════════════════════════
// Загрузка JSON-выгрузки бота в 1С. Платформа 8.3.27, учебная конфигурация.
// Имена объектов заданы здесь как эталон — создайте их в конфигураторе ровно
// так, и код ниже заработает без правок. Проверить в своей среде обязательно:
// я эту среду не запускаю.
// ═══════════════════════════════════════════════════════════════════════════
//
// ЧТО СОЗДАТЬ В КОНФИГУРАТОРЕ
//
// Справочник «Станки»
//   Код (стандартный, строка 9)      — номер станка: "151", "98", "14тр"
//   Наименование (строка 50)         — дублируем код (для читаемости списка)
//   Марка (реквизит, строка 50)
//   НормаТ (реквизит, число 6.2)     — отходов в минуту
//
// Справочник «Сотрудники»
//   Наименование (строка 100)        — ФИО ("Вашурина", "Пронкин")
//
// Документ «ОтчётСмены»
//   Реквизиты шапки:
//     Дата уже есть у документа; станок/оператор — ссылки на справочники:
//     Станок (СправочникСсылка.Станки)
//     Оператор (СправочникСсылка.Сотрудники)
//     ЧасыРаботыМашины, ЧасыОператора, НормаОператора,
//     НедостатокОператора, ПревышениеОператора,
//     НедостатокМашины, ПревышениеМашины  — число 6.2
//     НеобъяснённыйПростой (число 6.2)
//     ИнженернаяСлужбаВсюСмену (булево)
//     Расхождение (строка), Примечание (строка)
//   Табличная часть «Ассортимент»:
//     Ассортимент (строка), Клиент (строка), НомерЗаявки (строка),
//     КолвоПолотен (число), СчётчикНачало (число 12), СчётчикКонец (число 12),
//     ВыпускФакт (число 12), ВремяЧ (число 6.2)
//   Табличная часть «Простои»:
//     Причина (строка), Часы (число 6.2), ОператорРаботал (булево)
//   Табличная часть «ПривлечённыйПерсонал»:
//     Описание (строка), Часы (число 6.2)
//
// Как запустить: временная внешняя обработка с одной кнопкой, в обработчике —
//   ЗагрузитьВыгрузкуБота("C:\...\1С выгрузка 27.08.2026.json");
// ═══════════════════════════════════════════════════════════════════════════

Процедура ЗагрузитьВыгрузкуБота(ПутьКФайлу) Экспорт

    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(ПутьКФайлу, "UTF-8");
    Данные = ПрочитатьJSON(Чтение);      // Соответствие ключ -> значение
    Чтение.Закрыть();

    ДатаСмены = Дата(ПреобразоватьДату(Данные["дата"]));

    // 1. Справочники — сначала, чтобы ссылки уже существовали.
    Справочники = Данные["справочники"];
    Для Каждого Ст Из Справочники["станки"] Цикл
        ОбеспечитьСтанок(Ст["код"], Ст["марка"], Ст["норма_T_отходов_в_минуту"]);
    КонецЦикла;
    Для Каждого Чел Из Справочники["операторы"] Цикл
        ОбеспечитьСотрудника(Чел["фио"]);
    КонецЦикла;

    // 2. Документ на каждый станок.
    Для Каждого М Из Данные["станки"] Цикл

        Если М["нет_разбора"] = Истина Тогда
            Продолжить;   // станок был в переписке, но цифр нет — не грузим
        КонецЕсли;

        Док = Документы.ОтчётСмены.СоздатьДокумент();
        Док.Дата     = ДатаСмены;
        Док.Станок   = ОбеспечитьСтанок(М["станок"], М["марка"],
                            М["норма_T_отходов_в_минуту"]);
        Док.Оператор = ОбеспечитьСотрудника(М["оператор"]);

        МашБлок = М["машина_блок"];
        Док.ЧасыРаботыМашины        = Ч(МашБлок["часы_работы"]);
        Док.НедостатокМашины        = Ч(МашБлок["недостаток"]);
        Док.ПревышениеМашины        = Ч(МашБлок["превышение"]);
        Док.НеобъяснённыйПростой    = Ч(МашБлок["необъяснённый_простой"]);
        Док.ИнженернаяСлужбаВсюСмену = МашБлок["инженерная_служба_всю_смену"];

        ОпБлок = М["оператор_блок"];
        Док.ЧасыОператора       = Ч(ОпБлок["часы"]);
        Док.НормаОператора      = Ч(ОпБлок["норма"]);
        Док.НедостатокОператора = Ч(ОпБлок["недостаток"]);
        Док.ПревышениеОператора = Ч(ОпБлок["превышение"]);

        Док.Расхождение = СтрокаИлиПусто(М["расхождение"]);
        Док.Примечание  = СтрокаИлиПусто(М["примечание"]);

        Для Каждого Стр Из М["строки"] Цикл
            НС = Док.Ассортимент.Добавить();
            НС.Ассортимент   = СтрокаИлиПусто(Стр["ассортимент"]);
            НС.Клиент        = СтрокаИлиПусто(Стр["клиент"]);
            НС.НомерЗаявки   = СтрокаИлиПусто(Стр["номер_заявки"]);
            НС.КолвоПолотен  = Ч(Стр["кол_полотен"]);
            НС.СчётчикНачало = Ч(Стр["счётчик_начало"]);
            НС.СчётчикКонец  = Ч(Стр["счётчик_конец"]);
            НС.ВыпускФакт    = Ч(Стр["выпуск_фактический"]);
            НС.ВремяЧ        = Ч(Стр["время_ч"]);
        КонецЦикла;

        Для Каждого П Из МашБлок["простои"] Цикл
            НП = Док.Простои.Добавить();
            НП.Причина        = СтрокаИлиПусто(П["описание"]);
            НП.Часы           = Ч(П["часы"]);
            НП.ОператорРаботал = ?(П["оператор_работал"] = Неопределено,
                                    Ложь, П["оператор_работал"]);
        КонецЦикла;

        Для Каждого А Из М["привлечённый_персонал"]["строки"] Цикл
            НА = Док.ПривлечённыйПерсонал.Добавить();
            НА.Описание = СтрокаИлиПусто(А["описание"]);
            НА.Часы     = Ч(А["часы"]);
        КонецЦикла;

        Док.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;

    Сообщить("Выгрузка за " + Данные["дата"] + " загружена.");

КонецПроцедуры

// ─────────────────────────── вспомогательные ───────────────────────────

// Число из JSON: Неопределено/null -> 0.
Функция Ч(Знач)
    Возврат ?(Знач = Неопределено, 0, Знач);
КонецФункции

Функция СтрокаИлиПусто(Знач)
    Возврат ?(Знач = Неопределено, "", Строка(Знач));
КонецФункции

// "27.08.2026" -> "20260827" (формат, который понимает Дата()).
Функция ПреобразоватьДату(Текст)
    Ч = СтрРазделить(Текст, ".");
    Возврат Ч[2] + Ч[1] + Ч[0];
КонецФункции

// Найти станок по коду, создать при отсутствии. Возвращает ссылку.
Функция ОбеспечитьСтанок(Код, Марка = "", НормаТ = 0)
    Ссылка = Справочники.Станки.НайтиПоКоду(Строка(Код));
    Если Ссылка.Пустая() Тогда
        Эл = Справочники.Станки.СоздатьЭлемент();
        Эл.Код          = Строка(Код);
        Эл.Наименование = Строка(Код);
        Эл.Марка        = СтрокаИлиПусто(Марка);
        Эл.НормаТ       = Ч(НормаТ);
        Эл.Записать();
        Возврат Эл.Ссылка;
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

// Найти сотрудника по ФИО (наименованию), создать при отсутствии.
Функция ОбеспечитьСотрудника(ФИО)
    Если ПустаяСтрока(ФИО) Тогда
        Возврат Справочники.Сотрудники.ПустаяСсылка();
    КонецЕсли;
    Ссылка = Справочники.Сотрудники.НайтиПоНаименованию(Строка(ФИО), Истина);
    Если Ссылка.Пустая() Тогда
        Эл = Справочники.Сотрудники.СоздатьЭлемент();
        Эл.Наименование = Строка(ФИО);
        Эл.Записать();
        Возврат Эл.Ссылка;
    КонецЕсли;
    Возврат Ссылка;
КонецФункции
